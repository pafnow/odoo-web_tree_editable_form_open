<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="extension">
        <xpath expr="//tr[@class='o_data_row']" position="attributes">
            <attribute name="t-on-dblclick.capture">
                (ev) => this.onDblClickCapture(record, ev)
            </attribute>
        </xpath>
    </t>
</templates>
